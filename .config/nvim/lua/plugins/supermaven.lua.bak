return {
  {
    "supermaven-inc/supermaven-nvim",
    event = "BufReadPost",
    config = function()
      require("supermaven-nvim").setup({
        disable_keymaps = false,
        disable_inline_completion = false,
        keymaps = {
          accept_suggestion = "<S-Tab>",
          clear_suggestion = "<Nop>",
          accept_word = "<Nop>",
        },
      })
    end,
  },
}
